# Application Secret (Generate a strong random string)
PAYLOAD_SECRET=replace-with-a-strong-secret

# Server Public URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database
# Local SQLite default:
DATABASE_URI=file:./mfm-ottawa.db
# Production PostgreSQL (Neon, Supabase, or AWS RDS):
# DATABASE_URI=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Media Storage (Cloudflare R2 / AWS S3)
# S3_BUCKET=mfm-ottawa-media
# S3_ACCESS_KEY_ID=your-r2-or-s3-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-or-s3-secret-access-key
# S3_REGION=auto
# For Cloudflare R2, set the endpoint:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# Public CDN domain for R2:
R2_PUBLIC_URL=https://pub-607a3b66c887427195afea0db1d082a7.r2.dev

# Cloudflare MCP Server Credentials (for AI Agent to inspect/manage R2, DNS, Workers)
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
